<?xml version="1.0" encoding="UTF-8"?>
<definitions name="PayFlexPaymentService"
    targetNamespace="http://payflex.example.com/payments/v1"
    xmlns:tns="http://payflex.example.com/payments/v1"
    xmlns:xsd="http://www.w3.org/2001/XMLSchema"
    xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/"
    xmlns="http://schemas.xmlsoap.org/wsdl/">

  <!-- ============================================================ -->
  <!-- 1. TYPES: request / response / fault / header shapes          -->
  <!-- ============================================================ -->
  <types>
    <xsd:schema targetNamespace="http://payflex.example.com/payments/v1"
                xmlns="http://payflex.example.com/payments/v1"
                elementFormDefault="qualified">

      <xsd:element name="Credentials">
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element name="apiKey" type="xsd:string"/>
            <xsd:element name="merchantId" type="xsd:string"/>
            <xsd:element name="timestamp" type="xsd:dateTime"/>
            <xsd:element name="nonce" type="xsd:string"/>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>

      <xsd:element name="ChargeRequest">
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element name="merchantId" type="xsd:string"/>
            <xsd:element name="orderId" type="xsd:string"/>
            <xsd:element name="amount" type="xsd:decimal"/>
            <xsd:element name="currency" type="xsd:string"/>
            <xsd:element name="cardToken" type="xsd:string"/>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>

      <xsd:element name="ChargeResponse">
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element name="transactionId" type="xsd:string"/>
            <xsd:element name="status" type="xsd:string"/>
            <xsd:element name="authCode" type="xsd:string"/>
            <xsd:element name="amount" type="xsd:decimal"/>
            <xsd:element name="currency" type="xsd:string"/>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>

      <xsd:element name="ChargeFaultDetail">
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element name="faultCode" type="xsd:string"/>
            <xsd:element name="declineReason" type="xsd:string"/>
            <xsd:element name="orderId" type="xsd:string"/>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>

    </xsd:schema>
  </types>

  <!-- ============================================================ -->
  <!-- 2. MESSAGES                                                    -->
  <!-- ============================================================ -->
  <message name="ChargeRequestMessage">
    <part name="credentials" element="tns:Credentials"/>
    <part name="body" element="tns:ChargeRequest"/>
  </message>

  <message name="ChargeResponseMessage">
    <part name="body" element="tns:ChargeResponse"/>
  </message>

  <message name="ChargeFaultMessage">
    <part name="fault" element="tns:ChargeFaultDetail"/>
  </message>

  <!-- ============================================================ -->
  <!-- 3. PORT TYPE (abstract operation)                              -->
  <!-- ============================================================ -->
  <portType name="PaymentPortType">
    <operation name="charge">
      <input message="tns:ChargeRequestMessage"/>
      <output message="tns:ChargeResponseMessage"/>
      <fault name="ChargeFault" message="tns:ChargeFaultMessage"/>
    </operation>
  </portType>

  <!-- ============================================================ -->
  <!-- 4. BINDING (SOAP over HTTP, document/literal)                  -->
  <!-- ============================================================ -->
  <binding name="PaymentBinding" type="tns:PaymentPortType">
    <soap:binding style="document" transport="http://schemas.xmlsoap.org/soap/http"/>
    <operation name="charge">
      <soap:operation soapAction="http://payflex.example.com/payments/v1/charge"/>
      <input>
        <soap:header message="tns:ChargeRequestMessage" part="credentials" use="literal"/>
        <soap:body use="literal" parts="body"/>
      </input>
      <output>
        <soap:body use="literal"/>
      </output>
      <fault name="ChargeFault">
        <soap:fault name="ChargeFault" use="literal"/>
      </fault>
    </operation>
  </binding>

  <!-- ============================================================ -->
  <!-- 5 & 6. SERVICE / PORT (real-looking endpoint)                  -->
  <!-- ============================================================ -->
  <service name="PayFlexPaymentService">
    <port name="PaymentPort" binding="tns:PaymentBinding">
      <soap:address location="https://api.payflex.example.com/soap/v1/payments"/>
    </port>
  </service>

</definitions>
